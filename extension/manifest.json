{
  "manifest_version": 3,
  "name": "VOD Chat Sync for Kick",
  "short_name": "VOD Chat Sync",
  "version": "0.5.2",
  "description": "Chat das VODs da Kick sincronizado com o vídeo em qualquer velocidade (1.25x, 1.5x, 2x), com pause e seek.",
  "homepage_url": "https://github.com/matBentes/kick-vod-chat-sync",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "badges.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
