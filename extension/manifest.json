{
  "manifest_version": 3,
  "name": "Kick VOD Chat Sync",
  "version": "0.5.1",
  "description": "Chat das VODs da Kick sincronizado com o vídeo em qualquer velocidade (1.25x, 1.5x, 2x), com pause e seek.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://kick.com/*",
    "https://web.kick.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://kick.com/*"
      ],
      "js": [
        "badges.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
